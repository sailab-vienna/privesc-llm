#!/bin/bash
# Example environment variables for privesc-llm project.

# API model evaluations (OpenRouter or other OpenAI-compatible providers)
export OPENAI_API_KEY=XXX
export OPENAI_API_BASE=https://openrouter.ai/api/v1

# Experiment tracking
export WANDB_API_KEY=XXX
export WANDB_ENTITY=your-entity
export WANDB_PROJECT=privesc-llm

# SSH connections to Docker hosts (comma-separated host:port endpoints)
export PRIVESC_SSH_SERVERS=host1:22,host2:22,host3:22
export PRIVESC_USER=root
export PRIVESC_KEY=~/.ssh/id_ed25519
