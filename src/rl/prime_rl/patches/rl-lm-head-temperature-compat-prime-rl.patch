@@ -423,3 +426,37 @@ def test_hf_model_fused_vs_vanilla_matches():
     # Compare results
     torch.testing.assert_close(fused_logprobs, vanilla_logprobs, rtol=1e-3, atol=1e-4)
     torch.testing.assert_close(fused_entropy, vanilla_entropy, rtol=1e-3, atol=1e-4)
+
+
+class DictOutputLinear(nn.Linear):
+    def forward(self, x: torch.Tensor, *args, **kwargs):
+        return {"logits": super().forward(x), "meta": torch.tensor(1.0)}
+
+
+def test_multilora_linear_updates_logits_when_base_layer_returns_dict():
+    set_lora_num_tokens(torch.tensor([2], dtype=torch.int32), reset_reference=True)
+    set_multilora_scaling(torch.tensor([1.0], dtype=torch.bfloat16), reset_reference=True)
+
+    base = DictOutputLinear(4, 4, bias=False)
+    layer = MultiLoRALinear(base, rank=8, n_adapters=1)
+    x = torch.randn(1, 2, 4)
+
+    out = layer(x)
+
+    assert isinstance(out, dict)
+    assert out["logits"].shape == (1, 2, 4)
+    assert out["meta"].item() == 1.0
+
+
+def test_multilora_linear_forwards_weight_assignment_to_base_layer():
+    set_lora_num_tokens(torch.tensor([1], dtype=torch.int32), reset_reference=True)
+    set_multilora_scaling(torch.tensor([1.0], dtype=torch.bfloat16), reset_reference=True)
+
+    base = nn.Linear(4, 4, bias=False)
+    layer = MultiLoRALinear(base, rank=8, n_adapters=1)
+    new_weight = nn.Parameter(torch.randn_like(base.weight))
+
+    layer.weight = new_weight
+
+    assert layer.base_layer.weight is new_weight
+    assert layer.weight is new_weight
