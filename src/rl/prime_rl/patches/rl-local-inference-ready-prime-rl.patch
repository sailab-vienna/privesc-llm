+def wait_for_local_inference_ready(
+    process: Popen, port: int, host: str | None, timeout_s: int = 300
+) -> None:
+    probe_host = host or "127.0.0.1"
+    if probe_host == "0.0.0.0":
+        probe_host = "127.0.0.1"
+    url = f"http://{probe_host}:{port}/v1/models"
+    deadline = time.time() + timeout_s
+    while time.time() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError(
+                "Inference exited before becoming ready with exit code "
+                f"{process.returncode}"
+            )
+        try:
+            with urlopen(url, timeout=2) as response:
+                if 200 <= response.status < 300:
+                    return
+        except (HTTPError, TimeoutError, URLError):
+            pass
+        time.sleep(2)
+    raise TimeoutError(f"Inference did not become ready within {timeout_s}s: {url}")
+
